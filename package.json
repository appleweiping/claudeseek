{
  "name": "claudeseek",
  "version": "1.0.0",
  "description": "A zero-dependency coding agent for the DeepSeek API, with a terminal REPL and a local web UI. Not affiliated with Anthropic or DeepSeek.",
  "type": "module",
  "license": "MIT",
  "author": "Weiping Yan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleweiping/claudeseek.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "claudeseek": "bin/claudeseek.js",
    "cseek": "bin/claudeseek.js"
  },
  "main": "src/index.js",
  "files": [
    "bin/",
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/claudeseek.js",
    "doctor": "node bin/claudeseek.js --doctor",
    "demo": "node scripts/demo.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs core",
    "test:cli": "node scripts/run-tests.mjs cli",
    "test:server": "node scripts/run-tests.mjs server"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "deepseek",
    "coding-assistant",
    "llm",
    "web-ui"
  ]
}
